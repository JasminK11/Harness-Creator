{
  "permissions": {
    "ask": [
      "Bash(node *harness.mjs install*)",
      "Bash(node *harness.mjs uninstall*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Grep|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/zugriffsschutz.mjs"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/pruefpflicht.mjs"
          }
        ]
      }
    ]
  }
}
